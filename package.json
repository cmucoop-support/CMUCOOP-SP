{
  "name": "cmucoop-sp",
  "private": true,
  "version": "2.0.0",
  "description": "CMUCOOP static applications and modular D1 Worker",
  "scripts": {
    "test": "node --test worker/tests/*.test.mjs",
    "check": "node worker/scripts/check.mjs",
    "audit": "node worker/scripts/audit.mjs",
    "verify": "npm run check && npm run audit && npm test",
    "migrations": "node worker/scripts/migration.mjs",
    "test:browser": "node worker/tests/browser.e2e.mjs"
  },
  "engines": { "node": ">=18" },
  "devDependencies": { "playwright": "1.62.1" }
}
